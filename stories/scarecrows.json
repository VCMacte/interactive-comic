        { "label": "Подставить камни", "keywords": ["подставить", "подставим", "камни", "камнями", "сразу"],
          "dir": "forward", "next": "gate" }
      ]
    },
    "sniff": {
      "bg": { "sky": "assets/mc/sky-day.webp", "stars": "assets/mc/sun-day.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-gate-pumpkin.svg" },
      "cast": [
        { "src": "assets/mc/steve.svg", "x": 26, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 37, "y": 28, "w": 8 },
        { "src": "assets/mc/wolf.svg", "x": 47, "y": 28, "w": 7 },
        { "src": "assets/mc/scarecrow.svg", "x": 54, "y": 28, "w": 12 }
      ],
      "voice": "hero",
      "text": "Волк обошёл чучело, понюхал камень, фыркнул и чихнул. Стив засмеялся. «Волка не обманешь. Зато колдун не волк!»",
      "prompt": "Подставим камни?",
      "choices": [
        { "label": "Подставить камни", "keywords": ["подставить", "подставим", "камни", "дальше", "да"],
          "dir": "right", "next": "gate" }
      ]
    },
    "gate": {
      "bg": { "sky": "assets/mc/sky-day.webp", "stars": "assets/mc/sun-day.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-gate-pumpkin.svg" },
      "cast": [
        { "src": "assets/mc/wolf.svg", "x": 16, "y": 28, "w": 7 },
        { "src": "assets/mc/steve.svg", "x": 26, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 37, "y": 28, "w": 8 },
        { "src": "assets/mc/scarecrow.svg", "x": 54, "y": 28, "w": 12 }
      ],
      "voice": "ally",
      "text": "Кукла стояла у самых ворот. «Подставим камни, чтобы не качалась. Считай, сколько принесли!»",
      "task": { "kind": "math", "max": 19, "types": ["missing"], "topic": "scarecrow", "spread": "wide" },
      "next": "loud"
    },
    "loud": {
      "bg": { "sky": "assets/mc/sky-day.webp", "stars": "assets/mc/sun-day.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-gate-pumpkin.svg" },
      "cast": [
        { "src": "assets/mc/steve.svg", "x": 26, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 37, "y": 28, "w": 8 },
        { "src": "assets/mc/wolf.svg", "x": 47, "y": 28, "w": 7 },
        { "src": "assets/mc/scarecrow.svg", "x": 54, "y": 28, "w": 12 }
      ],
      "voice": "hero",
      "text": "Волк сел мордой к ёлкам и притих. Там кто-то смотрел! Стив понял и нарочно крикнул кукле на всю деревню! «Железный, стой тут! Ни шагу! И молчи!»",
      "prompt": "Крикнем ещё раз или стукнем настоящему Железному в стену кузницы?",
      "choices": [
        { "label": "Крикнуть ещё", "keywords": ["крикнуть", "крикнем", "ещё раз", "кричать", "ещё"],
          "voice": "hero", "say": "«Стой и молчи! Понял, Железный?» Чучело, конечно, промолчало.", "dir": "forward", "next": "trap" },
        { "label": "Стукнуть в стену", "keywords": ["стукнуть", "стукнем", "в стену", "стена", "кузница", "настоящего"],
          "voice": "golem", "say": "Стив тихонько стукнул в стену кузницы. Оттуда еле слышно загудели. «Стою. Молчу. Скучно»", "dir": "right", "next": "trap" }
      ]
    },
    "trap": {
      "bg": { "sky": "assets/mc/sky-sunset.webp", "stars": "assets/mc/sun-sunset.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-gate-pumpkin.svg" },
      "cast": [
        { "src": "assets/mc/steve.svg", "x": 26, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 37, "y": 28, "w": 8 },
        { "src": "assets/mc/wolf.svg", "x": 47, "y": 28, "w": 7 },
        { "src": "assets/mc/scarecrow.svg", "x": 54, "y": 28, "w": 12 },
        { "src": "assets/mc/sparks.svg", "x": 84, "y": 64, "w": 8 }
      ],
      "voice": "hero",
      "text": "К вечеру в ёлках мигнула лиловая искра. Стив зашептал на ухо. «Тихо! Он смотрит и слушает. Ловушка готова!»"
    }
  }
}
