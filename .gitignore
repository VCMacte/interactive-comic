# Скриншот настроек телевизора — на нём виден серийный номер.
tv.jpg

# Промежуточные файлы конвейера генерации: восстанавливаются скриптами
# tools/make-art.mjs и tools/paint-layers.mjs за считанные секунды,
# а весят десятки мегабайт.
tools/init/
tools/painted/
tools/out/

# Артефакты отладки в браузере
.playwright-mcp/

# Журналы, выгруженные с телефона: в них имя устройства, версия браузера
# и время, когда ребёнок играл. Папка и её README в репозитории остаются.
logs/*
!logs/README.md

# Нейросетевая озвучка: модель Silero и промежуточные WAV.
# В приложение уходят только сжатые MP3 из assets/audio.
tools/tts/models/
tools/tts/wav/

# Кэш импорта Python: check-accents.py и audit-accents.py тянут
# соседний accents.py, и рядом заводится __pycache__.
tools/tts/__pycache__/

# Ключ к fish.audio: личный, в репозиторий не идёт.
tools/tts/fish-key.txt
# Список «озвучено, но не сжато» — рабочий файл одного прогона.
tools/tts/fish-pending.json
