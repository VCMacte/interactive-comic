        { "label": "Что блестит?", "keywords": ["блестит", "что блестит", "посмотрим", "посмотреть", "блеск"],
          "voice": "kid", "say": "За тыквой блеснуло, и кто-то хрюкнул! «Хрю! Тут шумно! Унесу золото туда, где тихо!» Житель только пожал плечами.", "dir": "right", "next": "pick" }
      ]
    },
    "pick": {
      "bg": { "sky": "assets/mc/sky-day.webp", "stars": "assets/mc/sun-day.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-patch.svg" },
      "cast": [
        { "src": "assets/mc/steve.svg", "x": 12, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 22, "y": 28, "w": 8 },
        { "src": "assets/mc/villager.svg", "x": 33, "y": 28, "w": 7.6 },
