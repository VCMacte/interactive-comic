      "voice": "friend",
      "text": "Житель выкатил самую большую тыкву. «Хм-хм! Хороша голова! А вот загадка, пока катим!»",
      "task": { "kind": "logic", "max": 10, "types": ["oddOneOut"], "topic": "scarecrow" },
      "next": "build"
    },
    "build": {
      "bg": { "sky": "assets/mc/sky-day.webp", "stars": "assets/mc/sun-day.svg", "far": "assets/mc/far-hills.webp", "near": "assets/mc/near-gate-pumpkin.svg" },
      "cast": [
        { "src": "assets/mc/wolf.svg", "x": 16, "y": 28, "w": 7 },
        { "src": "assets/mc/steve.svg", "x": 26, "y": 28, "w": 8 },
        { "src": "assets/mc/alex.svg", "x": 37, "y": 28, "w": 8 },
